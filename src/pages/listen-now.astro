---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
---
<Layout title="Listen Now" description="Listen to the Draper Family Light Show online, or tune to 106.9 FM.">

  <section class="max-w-3xl mx-auto px-4 py-14">
    <p class="section-label text-center mb-2">106.9 FM</p>
    <h1 class="text-3xl md:text-4xl font-extrabold text-center mb-3" style="color: var(--text)">Listen Online</h1>
    <p class="text-center text-sm mb-10" style="color: var(--text-muted)">
      Tune your car radio to <strong style="color: var(--accent)">106.9 FM</strong> at the show, or stream right here from anywhere.
    </p>

    <div class="card overflow-hidden">
      <div class="px-5 pt-5 pb-3">
        <div class="flex items-center gap-2 mb-1">
          <span class="live-dot"></span>
          <span class="section-label">Draper Family Light Show</span>
        </div>
        <p class="text-xs" style="color: var(--text-subtle)">Streaming via Pulsemesh · 106.9 FM Kenton, Ohio</p>
      </div>
      <iframe
        id="webplayer"
        title="Draper Family Light Show Web Player"
        width="100%"
        height="280"
        style="border:none;overflow:hidden;"
        allow="geolocation"
        src="https://player.pulsemesh.io/d/VPQ8"
        loading="lazy"
      ></iframe>
    </div>

    <div class="grid sm:grid-cols-2 gap-4 mt-8">
      <div class="card p-5">
        <p class="font-semibold mb-1 flex items-center gap-1.5" style="color: var(--text)"><Icon name="car" size={16} />At the Show</p>
        <p class="text-sm" style="color: var(--text-muted)">Park in front of the house and tune your car radio to <strong style="color: var(--accent)">106.9 FM</strong>. Volume up, lights out. Enjoy the show.</p>
      </div>
      <div class="card p-5">
        <p class="font-semibold mb-1 flex items-center gap-1.5" style="color: var(--text)"><Icon name="map-pin" size={16} />Find Us</p>
        <p class="text-sm" style="color: var(--text-muted)">352 N Cherry St<br />Kenton, OH 43326</p>
        <a href="https://www.google.com/maps/search/?api=1&query=352+N+Cherry+St+Kenton+OH+43326"
           target="_blank" rel="noopener noreferrer"
           class="text-xs font-semibold mt-2 inline-block" style="color: var(--accent)">
          Get Directions →
        </a>
      </div>
    </div>
  </section>

</Layout>
