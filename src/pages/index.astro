---
import Layout from '../layouts/Layout.astro';
import NowPlaying from '../components/NowPlaying.astro';
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';
import rawSettings from '../content/settings/site.json';

const shows = (await getCollection('shows')).sort((a, b) => a.data.order - b.data.order);

const settings = rawSettings;

const heroShow = shows.find((s) => s.data.featured) ?? shows[0];
---
<Layout title="Home" description="Free holiday light and projection shows and the Scary On Cherry haunted house in Kenton, Ohio. 352 N Cherry St.">

  <!-- HERO -->
  <section class="hero-section">
    <div class="hero-inner">
      <div class="hero-content">
        <p class="section-label mb-3">352 N Cherry St · Kenton, Ohio</p>
        <h1 class="hero-title">
          {settings.showActive ? (
            <>The Show is <span style="color: var(--accent)">On Tonight</span></>
          ) : heroShow ? (
            <>{heroShow?.data.title} is <span style="color: var(--accent)">Coming</span></>
          ) : (
            <>Draper Family <span style="color: var(--accent)">Light Show</span></>
          )}
        </h1>
        <p class="hero-sub">
          Free holiday light and projection shows choreographed to music, year-round in Kenton, Ohio.
          Featuring the <strong>Scary on Cherry</strong> haunted experience every October.
        </p>
        <div class="hero-actions">
          <a href="/event-schedule" class="btn-accent">See Show Dates</a>
          <a href="/now-playing" class="btn-outline">Now Playing</a>
        </div>
      </div>
    </div>
  </section>

  <!-- NOW PLAYING WIDGET - full width card section -->
  <section class="widget-section">
    <div class="max-w-4xl mx-auto px-4">
      <NowPlaying
        showActive={settings.showActive}
        nextEventName={settings.nextEventName}
        nextEventDate={settings.nextEventDate}
        nowPlayingImage={settings.nowPlayingImage}
        season={settings.season}
      />
    </div>
  </section>

  <!-- SHOWS GRID -->
  <section class="max-w-6xl mx-auto px-4 py-16">
    <p class="section-label text-center mb-2">Our Shows</p>
    <h2 class="text-3xl font-bold text-center mb-10" style="color: var(--text)">
      Year-Round Celebrations
    </h2>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {shows.map((show) => {
        const title = show.data.title;
        return (
          <a href={`/shows/${show.id}`} class="card block group no-underline">
            <div class="h-1.5 rounded-t-[inherit]" style={`background-color:${show.data.accent}`}></div>
            {show.data.heroImage && (
              <div class="h-36 overflow-hidden">
                <img
                  src={show.data.heroImage}
                  alt={title}
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
              </div>
            )}
            <div class="p-5">
              <p class="text-xs uppercase tracking-wide mb-1" style="color: var(--text-subtle)">{show.data.months}</p>
              <h3 class="font-bold text-base mb-1.5" style="color: var(--text)">{title}</h3>
              <p class="text-sm leading-relaxed" style="color: var(--text-muted)">{show.data.tagline}</p>
              <p class="text-xs mt-3 font-semibold" style="color: var(--accent)">Learn more →</p>
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <!-- ABOUT BAND -->
  <section class="about-section">
    <div class="max-w-5xl mx-auto px-4 py-16 grid md:grid-cols-3 gap-10 text-center">
      <div class="about-card">
        <div class="about-icon"><Icon name="sparkles" size={36} /></div>
        <h3 class="font-bold text-lg mb-2" style="color: var(--text)">Always Free</h3>
        <p class="text-sm leading-relaxed" style="color: var(--text-muted)">Every single show. No tickets, no parking fees, no catches. Just pull up, park, and enjoy.</p>
      </div>
      <div class="about-card">
        <div class="about-icon"><Icon name="music" size={36} /></div>
        <h3 class="font-bold text-lg mb-2" style="color: var(--text)">Synced to Music</h3>
        <p class="text-sm leading-relaxed" style="color: var(--text-muted)">Thousands of lights choreographed beat-for-beat. Tune to <strong style="color: var(--accent)">106.9 FM</strong> in your car or listen online.</p>
      </div>
      <div class="about-card">
        <div class="about-icon"><Icon name="heart" size={36} /></div>
        <h3 class="font-bold text-lg mb-2" style="color: var(--text)">Community & Charity</h3>
        <p class="text-sm leading-relaxed" style="color: var(--text-muted)">Every show supports the United Way of Hardin County and St. Jude Children's Research Hospital.</p>
      </div>
    </div>
  </section>

  <!-- DONATE CTA -->
  <section class="max-w-3xl mx-auto px-4 py-16 text-center">
    <p class="section-label mb-2">Support the Show</p>
    <h2 class="text-2xl font-bold mb-4" style="color: var(--text)">Help Us Keep the Lights On</h2>
    <p class="mb-8 text-sm leading-relaxed" style="color: var(--text-muted)">
      Every show is free. Donations go directly to the United Way of Hardin County and St. Jude, not to us.
    </p>
    <a href="/donate" class="btn-accent">Donate Now</a>
  </section>

  <!-- LOCATION CTA -->
  <section class="location-section">
    <div class="max-w-4xl mx-auto px-4 py-16 text-center">
      <p class="section-label mb-2">Come See Us</p>
      <h2 class="text-2xl font-bold mb-2" style="color: var(--text)">352 N Cherry St, Kenton OH 43326</h2>
      <p class="text-sm mb-8" style="color: var(--text-muted)">Open during the holidays listed on our schedule. Always free.</p>
      <div class="flex gap-4 justify-center flex-wrap">
        <a href="/event-schedule" class="btn-accent">Show Schedule</a>
        <a href="https://www.google.com/maps/search/?api=1&query=352+N+Cherry+St+Kenton+OH+43326" target="_blank" rel="noopener noreferrer" class="btn-outline">Get Directions</a>
      </div>
    </div>
  </section>

</Layout>

<style>
  .hero-section {
    background: var(--hero-grad);
    border-bottom: 1px solid var(--border);
    padding: 5rem 1rem 4rem;
  }
  .hero-inner {
    max-width: 56rem;
    margin: 0 auto;
    text-align: center;
  }
  .hero-title {
    font-size: clamp(2rem, 5vw, 3.75rem);
    font-weight: 900;
    line-height: 1.1;
    color: var(--text);
    margin-bottom: 1.25rem;
  }
  .hero-sub {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--text-muted);
    max-width: 38rem;
    margin: 0 auto 2rem;
  }
  .hero-actions {
    display: flex;
    gap: 0.875rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .widget-section {
    padding: 3rem 1rem;
    background: linear-gradient(to bottom, var(--surface-2), var(--bg));
  }

  .about-section {
    background-color: var(--surface);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .about-card {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .about-icon {
    color: var(--accent);
    margin-bottom: 0.75rem;
    display: flex;
    justify-content: center;
  }

  .location-section {
    background-color: var(--surface);
    border-top: 1px solid var(--border);
  }
</style>
