---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import AnnouncementBanner from '../components/AnnouncementBanner.astro';
import '../styles/global.css';
import rawSettings from '../content/settings/site.json';
import { getCollection } from 'astro:content';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = 'Free holiday light & projection shows and the Scary On Cherry haunted house in Kenton, Ohio.',
  image = '/images/og-default.jpg',
} = Astro.props;

const settings = rawSettings;
const testMode = import.meta.env.PUBLIC_TEST_MODE === 'true';

// Build a minimal event list for the blocking season/live-detection script
const _allEvents = await getCollection('events');
const layoutEventList = _allEvents
  .filter(e => !e.data.cancelled)
  .map(e => ({
    date: e.data.date.toISOString().slice(0, 10),
    showSlug: e.data.showSlug ?? null,
  }))
  .sort((a, b) => a.date.localeCompare(b.date));
---
<!doctype html>
<html lang="en" data-season={settings.season}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#0a0a12" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Mountains+of+Christmas:wght@400;700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <!-- Blocking script: sets data-season and data-show-live before first paint — no flash -->
    <script is:inline define:vars={{ layoutEventList }}>
    (function() {
      var d = new Date();
      var todayStr = d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0');
      var lookahead = new Date(d.getTime() + 10 * 864e5);
      var lookaheadStr = lookahead.getFullYear() + '-' + String(lookahead.getMonth()+1).padStart(2,'0') + '-' + String(lookahead.getDate()).padStart(2,'0');
      var SEASON = { 'scary-on-cherry': 'halloween', 'merry-on-cherry': 'christmas' };

      var isLive = layoutEventList.some(function(e) { return e.date === todayStr; });
      if (isLive) document.documentElement.dataset.showLive = 'true';

      var seasonal = layoutEventList.find(function(e) {
        return e.date === todayStr && e.showSlug && SEASON[e.showSlug];
      });
      if (!seasonal) {
        seasonal = layoutEventList.filter(function(e) {
          return e.date > todayStr && e.date <= lookaheadStr && e.showSlug && SEASON[e.showSlug];
        }).sort(function(a, b) { return a.date.localeCompare(b.date); })[0];
      }
      if (seasonal) document.documentElement.dataset.season = SEASON[seasonal.showSlug];
    })();
    </script>
    <title>{title} | Draper Family Light Show</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={`${title} | Draper Family Light Show`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | Draper Family Light Show`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
  </head>
  <body>
    {testMode && (
      <div style="background:#b45309;color:#fff;text-align:center;padding:0.5rem 1rem;font-size:0.8125rem;font-weight:700;letter-spacing:0.05em;position:sticky;top:0;z-index:100;">
        TEST MODE: Square sandbox active · Emails redirect to thedraperpro@gmail.com · Not visible to public
      </div>
    )}
    {settings.announcement && (
      <AnnouncementBanner message={settings.announcement} link={settings.announcementLink} />
    )}
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
    <script>
      // Register service worker for PWA
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
  </body>
</html>
