# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env for local development.
# .env is gitignored — never commit real credentials.
#
# HOW THIS WORKS:
#   .env controls what gets BAKED INTO the site when you run "npm run publish".
#   Cloudflare Worker secrets control backend API behavior at runtime.
#   Both must match for a given environment (sandbox or production).
# ─────────────────────────────────────────────────────────────────────────────


# ─── SANDBOX MODE (for testing with fake cards) ───────────────────────────────
#
# Use these values while testing. Payments go to Square's test environment.
# Test card: 4111 1111 1111 1111  |  Exp: any future date  |  CVV: any 3 digits
#
# PUBLIC_TEST_MODE=true
# PUBLIC_SQUARE_APP_ID=sandbox-sq0idb-XXXXXXXXXXXXXXXXXXXXXXXX
# PUBLIC_SQUARE_LOCATION_ID=LXXXXXXXXXXXXXXXX
#
# Worker secret to set separately (run in terminal):
#   npx wrangler secret put SQUARE_ACCESS_TOKEN
#   → paste your SANDBOX Access Token (starts with EAAAlxxxxx from Sandbox tab)


# ─── PRODUCTION MODE (for the real show, real donations) ──────────────────────
#
# Switch to these when you are ready to accept real payments.
# Everything below is what "npm run publish" uses when you go live.
#
PUBLIC_TEST_MODE=false
PUBLIC_SQUARE_APP_ID=sq0idb-XXXXXXXXXXXXXXXXXXXXXXXX
PUBLIC_SQUARE_LOCATION_ID=LXXXXXXXXXXXXXXXX
#
# Worker secret to set separately (run in terminal):
#   npx wrangler secret put SQUARE_ACCESS_TOKEN
#   → paste your PRODUCTION Access Token (starts with EAAAlxxxxx from Production tab)


# ─── Keystatic CMS ────────────────────────────────────────────────────────────
# Only needed when running the admin locally (npm run dev).
# In production these are already set as Cloudflare Worker secrets.
KEYSTATIC_SECRET=


# ─── Resend (confirmation emails) ─────────────────────────────────────────────
# Get your API key at resend.com → API Keys
# RESEND_FROM_EMAIL must be a domain or email you have verified in Resend.
#
# Worker secrets — set once in terminal, never in this file:
#   npx wrangler secret put RESEND_API_KEY
#   npx wrangler secret put RESEND_FROM_EMAIL
#
# For local dev only (optional — emails skip silently if not set):
# RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# RESEND_FROM_EMAIL=tickets@draperlightshow.com
