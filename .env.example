# ─── Copy this file to .env for local development ────────────────────────────
# .env is gitignored. Never commit real credentials.

# ─── Test mode ───────────────────────────────────────────────────────────────
# Set to "true" to show the TEST MODE banner and use sandbox services
PUBLIC_TEST_MODE=true

# ─── Keystatic CMS (only needed for GitHub mode, leave blank for local dev) ───
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=

# ─── Square Payments ─────────────────────────────────────────────────────────
# Use SANDBOX credentials locally and in preview. Use PRODUCTION on main only.
# Get sandbox credentials at: https://developer.squareup.com/apps
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=EAAAlxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SQUARE_LOCATION_ID=LxxxxxxxxxxxxX

# ─── Resend (email confirmations) ────────────────────────────────────────────
# Get free API key at: https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# In test mode, ALL confirmation emails go to this address instead of the guest
RESEND_TEST_EMAIL=thedraperpro@gmail.com
# The "From" address (must be a verified domain in Resend)
RESEND_FROM_EMAIL=tickets@draperlightshow.com
