---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Listen Now" description="Listen to the Draper Family Light Show online, or tune to 106.9 FM.">
  <section class="max-w-3xl mx-auto px-4 py-16 text-center">
    <h1 class="text-3xl md:text-4xl font-extrabold text-midnight mb-4">Listen Now</h1>
    <p class="text-slate-600 mb-8">
      Tune your car radio to <strong>106.9 FM</strong> while you're parked at the show, or press play below to
      listen from anywhere.
    </p>

    <div class="rounded-xl overflow-hidden shadow-lg">
      <iframe
        id="webplayer"
        title="Draper Family Light Show Web Player"
        width="100%"
        height="500"
        frameborder="0"
        scrolling="no"
        allow="geolocation"
        src="https://player.pulsemesh.io/d/VPQ8"
      ></iframe>
    </div>
  </section>
</Layout>
