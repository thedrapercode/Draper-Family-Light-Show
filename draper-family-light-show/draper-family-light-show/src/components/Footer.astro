---
const socials = [
  { name: 'Facebook', url: 'https://www.facebook.com/draperfamilylightshow/' },
  { name: 'Instagram', url: 'https://www.instagram.com/draperfamilylightshow/' },
  { name: 'TikTok', url: 'https://www.tiktok.com/@draperfamilyshow' },
  { name: 'YouTube', url: 'https://www.youtube.com/@draperfamilylightshow' },
];
---
<footer class="bg-midnightdark text-slate-200 mt-16">
  <div class="max-w-6xl mx-auto px-4 py-10 grid gap-8 md:grid-cols-3">
    <div>
      <h2 class="font-bold text-white text-lg mb-2">Draper Family Light Show</h2>
      <p class="text-sm text-slate-300">352 N Cherry St<br />Kenton, OH 43326</p>
      <p class="text-sm text-slate-300 mt-2">Free, family-friendly light &amp; projection shows all year long.</p>
    </div>
    <div>
      <h3 class="font-semibold text-white mb-2">Explore</h3>
      <ul class="text-sm space-y-1 text-slate-300">
        <li><a href="/event-schedule" class="hover:text-white">Event Schedule</a></li>
        <li><a href="/listen-now" class="hover:text-white">Listen Now (106.9 FM)</a></li>
        <li><a href="/now-playing" class="hover:text-white">Now Playing</a></li>
        <li><a href="/donate" class="hover:text-white">Donate</a></li>
        <li><a href="/contact" class="hover:text-white">Contact</a></li>
      </ul>
    </div>
    <div>
      <h3 class="font-semibold text-white mb-2">Follow Along</h3>
      <ul class="text-sm space-y-1 text-slate-300">
        {socials.map((s) => (
          <li><a href={s.url} target="_blank" rel="noopener noreferrer" class="hover:text-white">{s.name}</a></li>
        ))}
      </ul>
    </div>
  </div>
  <div class="string-lights"></div>
  <div class="text-center text-xs text-slate-400 py-4">
    &copy; {new Date().getFullYear()} Draper Family Light Show. All Rights Reserved.
  </div>
</footer>
